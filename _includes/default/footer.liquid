<footer class="site-footer">
    <p class="text">
        {% if site.footer_copyright_start_year %}
        {% assign copyright_start_year = site.footer_copyright_start_year | append: '' %}
        {% assign copyright_end_year = site.time | date: '%Y' %}
        Copyright {{ copyright_start_year }}{% if copyright_start_year < copyright_end_year %}–{{ copyright_end_year }}{% endif %} ·
        {% endif %}
        {{ site.footer_text | default: "Powered by <a href='https://jekyllrb.com/'>Jekyll</a> with <a href='https://github.com/sylhare/Type-on-Strap'>Type on Strap</a>" }}</p>
    <nav class="footer-github" aria-label="GitHub organizations">
        <span>GitHub</span>
        <a href="https://github.com/neolea">NeoLEA</a>
        <a href="https://github.com/ail-project/">AIL Project</a>
        <a href="https://github.com/misp">MISP</a>
    </nav>
            <div class="footer-icons">
                <ul>
                <!-- Social icons from Font Awesome, if enabled -->
                {% include social/icons.liquid %}
                </ul>
            </div>
    {% if site.footer_disclaimer %}
    <small class="footer-disclaimer">{{ site.footer_disclaimer | escape }}</small>
    {% endif %}
</footer>


